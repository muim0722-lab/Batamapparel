<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <h1><%= title %></h1>
    <div class="sub"><%= row ? 'Ubah data yang sudah ada' : 'Lengkapi data di bawah' %></div>
  </div>
  <div class="page-actions no-print">
    <a class="btn btn-outline btn-sm" href="<%= url(base) %>">← Kembali</a>
  </div>
</div>
<%- include('../partials/flash') %>

<form method="post" action="<%= url(base + '/save') %>">
  <input type="hidden" name="id" value="<%= row ? row.id : 0 %>">
  <div class="card">
    <div class="card-head"><h3>Form <%= singular %></h3></div>
    <div class="card-body">
      <div class="form-grid">
        <% fields.forEach(function(f){ %>
          <div class="field <%= f.type === 'textarea' ? 'span-2' : '' %>">
            <label><%= f.label %> <%= f.required ? '<span class="req">*</span>' : '' %></label>
            <% if (f.type === 'textarea') { %>
              <textarea name="<%= f.name %>" placeholder="<%= f.placeholder || '' %>"><%= row ? (row[f.name] || '') : '' %></textarea>
            <% } else if (f.type === 'checkbox') { %>
              <label class="check"><input type="checkbox" name="<%= f.name %>" value="1" <%= !row || row[f.name] ? 'checked' : '' %>> <span><%= f.label %></span></label>
            <% } else if (f.type === 'number') { %>
              <input type="number" step="0.01" name="<%= f.name %>" value="<%= row ? util.num(row[f.name]) : '' %>" placeholder="<%= f.placeholder || '0' %>" <%= f.required ? 'required' : '' %>>
            <% } else { %>
              <input type="text" name="<%= f.name %>" value="<%= row ? (row[f.name] || '') : '' %>" placeholder="<%= f.placeholder || '' %>" <%= f.required ? 'required' : '' %>>
            <% } %>
          </div>
        <% }); %>
      </div>
      <% if (base === '/master/bahan') { %>
        <div class="alert alert-info" style="margin-top:16px">
          <span>ℹ️</span>
          <div>
            Isi <b>Satuan</b> dengan satuan yang dipakai untuk stok &amp; pemakaian harian (mis. <b>meter</b>).
            Kalau bahan sering dibeli dalam satuan lain (mis. <b>kg</b> atau <b>roll</b>), atur konversinya sekali saja di
            <a href="<%= url('/master/pengaturan') %>">Pengaturan → Konversi Satuan Bahan</a> — kolom Satuan di pembelian nanti
            otomatis menyediakan pilihan tersebut.
          </div>
        </div>
        <div class="alert alert-info" style="margin-top:16px">
          <span>ℹ️</span>
          <div>Stok bahan tidak diubah dari form ini agar riwayat tetap akurat. Stok bertambah lewat <b>Pembelian Bahan</b>, berkurang lewat <b>Bahan Terpakai</b>, dan bisa dikoreksi lewat <b>Kartu Stok → Stok Opname</b>.</div>
        </div>
      <% } %>
      <% if (base === '/master/customer' && row) { %>
        <div class="alert alert-info" style="margin-top:16px">
          <span>🔗</span>
          <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;width:100%">
            <div style="flex:1;min-width:220px">
              <b>Portal tracking customer ini</b><br>
              Berikan link tracking agar customer bisa memantau proses produksi sendiri (hanya melihat project &amp; invoice miliknya).
            </div>
            <a class="btn btn-primary btn-sm" href="<%= url('/master/customer?link=' + row.id) %>">🔗 Buka / Kirim Link Tracking</a>
          </div>
        </div>
      <% } %>
      <% if (base === '/master/customer' && !row) { %>
        <div class="alert alert-info" style="margin-top:16px">
          <span>ℹ️</span>
          <div>Isi <b>No. HP/WA</b> dengan benar — nomor ini dipakai customer untuk login ke halaman tracking pesanan. Link tracking bisa dibuat setelah data ini disimpan.</div>
        </div>
      <% } %>
    </div>
  </div>
  <div class="card">
    <div class="card-body" style="display:flex;gap:10px">
      <button class="btn btn-primary" type="submit">Simpan</button>
      <a class="btn btn-outline" href="<%= url(base) %>">Batal</a>
    </div>
  </div>
</form>
<%- include('../partials/foot') %>
