<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <h1>Laporan Barang Rijek</h1>
    <div class="sub">Catatan produk cacat / gagal produksi beserta nilai kerugian · Periode <b><%= p.label %></b></div>
  </div>
  <div class="page-actions no-print">
    <button class="btn btn-outline btn-sm" data-print="portrait">🖨 Cetak A4</button>
    <button class="btn btn-outline btn-sm" data-print="landscape">↔ A4 Landscape</button>
    <button class="btn btn-outline btn-sm" onclick="exportExcel('tblRejects','barang-rijek-<%= p.from %>-sd-<%= p.to %>',{title:'Laporan Barang Rijek',period:'<%= p.label %>',sheet:'Barang Rijek',by:'<%= user.name %>'})">⬇ Excel</button>
    <a class="btn btn-primary btn-sm" href="<%= url('/transaksi/barang-rijek/baru') %>">+ Catat Rijek</a>
  </div>
</div>
<%- include('../partials/flash') %>

<div class="grid-kpi">
  <div class="kpi tone-red">
    <div class="kpi-label">Total Nilai Kerugian</div>
    <div class="kpi-value"><%= util.rp(total) %></div>
    <div class="kpi-sub"><%= rows.length %> kejadian · <%= p.label %></div>
  </div>
  <div class="kpi tone-amber">
    <div class="kpi-label">Total Qty Rijek</div>
    <div class="kpi-value"><%= util.angka(totalQty) %> pcs</div>
    <div class="kpi-sub">unit yang cacat / gagal</div>
  </div>
  <div class="kpi tone-navy">
    <div class="kpi-label">Alasan Terbanyak</div>
    <div class="kpi-value" style="font-size:17px"><%= byReason.length ? util.truncated(byReason[0].label, 22) : '-' %></div>
    <div class="kpi-sub"><%= byReason.length ? util.rp(byReason[0].value) : util.rp(0) %></div>
  </div>
  <div class="kpi tone-purple">
    <div class="kpi-label">Rata-rata Kerugian</div>
    <div class="kpi-value"><%= rows.length ? util.rp(total / rows.length) : util.rp(0) %></div>
    <div class="kpi-sub">per kejadian rijek</div>
  </div>
</div>

<form class="filters no-print" method="get" action="<%= url('/transaksi/barang-rijek') %>">
  <%- include('../partials/period') %>
  <div class="field" style="min-width:220px">
    <label>Cari barang / alasan</label>
    <input type="text" name="q" value="<%= filters.q %>" placeholder="nama item, alasan, keterangan">
  </div>
  <div class="field"><label>&nbsp;</label><button class="btn btn-light btn-sm" type="submit">Filter</button></div>
</form>

<div class="card">
  <div class="card-body tight">
    <div class="table-wrap">
      <table class="tbl" id="tblRejects">
        <thead>
          <tr><th>Tanggal</th><th>Item Rijek</th><th>Project</th><th class="num">Qty</th><th>Alasan</th><th>Tindakan</th><th class="num">Kerugian</th><th>Dicatat oleh</th><th class="no-export no-print">Aksi</th></tr>
        </thead>
        <tbody>
        <% if (!rows.length) { %>
          <tr class="no-export"><td colspan="9"><div class="empty"><span class="big">♻️</span>Belum ada catatan barang rijek pada periode ini.</div></td></tr>
        <% } %>
        <% rows.forEach(function(r){ %>
          <tr>
            <td class="nowrap" data-export="<%= util.dmy(r.date) %>"><%= util.dmy(r.date) %></td>
            <td><%= r.item_name %><div class="subtext"><%= r.material_name || r.note || '' %></div></td>
            <td><%= r.project_code ? r.project_code + ' — ' + (r.customer_name || r.project_name) : '-' %></td>
            <td class="num mono" data-num="<%= util.num(r.qty) %>"><%= util.angka(r.qty) %> <%= r.unit %></td>
            <td><%= r.reason || '-' %></td>
            <td><span class="badge b-amber"><%= r.action %></span></td>
            <td class="num mono" data-num="<%= util.num(r.loss_cost) %>"><%= util.rp(r.loss_cost) %></td>
            <td><%= r.oleh || '-' %></td>
            <td class="no-export no-print nowrap">
              <% if (perm.edit) { %><a class="btn btn-outline btn-sm" href="<%= url('/transaksi/barang-rijek/' + r.id + '/edit') %>">Edit</a><% } %>
              <% if (perm.del) { %>
                <form method="post" action="<%= url('/transaksi/barang-rijek/' + r.id + '/delete') %>" style="display:inline" data-confirm="Hapus catatan rijek ini?">
                  <button class="btn btn-danger btn-sm" type="submit">Hapus</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3">TOTAL</td>
            <td class="num mono" data-num="<%= util.num(totalQty) %>"><%= util.angka(totalQty) %></td>
            <td colspan="2"></td>
            <td class="num mono" data-num="<%= util.num(total) %>"><%= util.rp(total) %></td>
            <td colspan="2" class="no-export"></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>

<div class="grid grid-2">
  <div class="card">
    <div class="card-head"><h3>Kerugian per Alasan</h3></div>
    <div class="card-body">
      <% if (!byReason.length) { %><p class="subtext">Belum ada data.</p><% } %>
      <div class="bar-list">
        <% const maxR = Math.max(1, ...byReason.map(function(c){ return c.value; })); %>
        <% byReason.forEach(function(c){ %>
          <div class="row">
            <span><%= c.label %></span><span class="mono"><%= util.rp(c.value) %></span>
            <div class="track"><span style="width:<%= Math.round(c.value / maxR * 100) %>%"></span></div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-head"><h3>Rekomendasi Sistem</h3></div>
    <div class="card-body">
      <% if (!rows.length) { %>
        <p class="subtext">Belum ada data rijek pada periode ini. Bagus! 🎉</p>
      <% } else { %>
        <ul style="margin:0;padding-left:18px;font-size:13.2px">
          <li>Kerugian terbesar: <b><%= byReason.length ? byReason[0].label : '-' %></b> senilai <b><%= util.rp(byReason.length ? byReason[0].value : 0) %></b>.</li>
          <li>Tindakan terbanyak: <b><%= rows[0] ? rows[0].action : '-' %></b>.</li>
          <li>Total <%= util.angka(totalQty) %> pcs rijek dari <%= rows.length %> kejadian.</li>
          <li>Evaluasi tahap <b>Quality Control</b> &amp; <b>Printing</b> bila rijek didominasi kesalahan cetak.</li>
        </ul>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
