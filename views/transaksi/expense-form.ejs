<%- include('../partials/head') %>
<div class="page-head">
  <div>
    <h1><%= row.id ? 'Edit Pengeluaran' : 'Pengeluaran Baru' %></h1>
    <div class="sub">Catat biaya operasional, gaji, transport, listrik, dll</div>
  </div>
  <div class="page-actions no-print">
    <a class="btn btn-outline btn-sm" href="<%= url('/transaksi/pengeluaran') %>">← Daftar Pengeluaran</a>
  </div>
</div>
<%- include('../partials/flash') %>

<form method="post" action="<%= url('/transaksi/pengeluaran/save') %>">
  <input type="hidden" name="id" value="<%= row.id || 0 %>">
  <div class="card">
    <div class="card-head"><h3>Detail Pengeluaran</h3></div>
    <div class="card-body">
      <div class="form-grid">
        <div class="field">
          <label>Tanggal <span class="req">*</span></label>
          <input type="date" name="date" value="<%= row.date %>" required>
        </div>
        <div class="field">
          <label>Nominal (Rp) <span class="req">*</span></label>
          <input type="text" class="money" name="amount" value="<%= row.amount !== '' ? util.num(row.amount) : '' %>" required placeholder="0">
        </div>
        <div class="field">
          <label>Kategori</label>
          <select name="category">
            <% categories.forEach(function(c){ %><option value="<%= c %>" <%= row.category === c ? 'selected' : '' %>><%= c %></option><% }); %>
          </select>
        </div>
        <div class="field">
          <label>Sumber Dana</label>
          <select name="source">
            <% sources.forEach(function(s){ %><option value="<%= s %>" <%= row.source === s ? 'selected' : '' %>><%= s %></option><% }); %>
          </select>
          <div class="help">Pengeluaran lewat petty cash sebaiknya dicatat dari menu Petty Cash (otomatis masuk di sini).</div>
        </div>
        <div class="field span-2">
          <label>Keterangan</label>
          <input type="text" name="description" value="<%= row.description || '' %>" placeholder="cth: Beli tinta sublimasi 4 botol">
        </div>
        <div class="field">
          <label>Kaitkan ke Project (opsional)</label>
          <select name="project_id">
            <option value="">— tidak dikaitkan —</option>
            <% projects.forEach(function(pr){ %>
              <option value="<%= pr.id %>" <%= String(row.project_id) === String(pr.id) ? 'selected' : '' %>><%= pr.code %> — <%= pr.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label>Catatan Tambahan</label>
          <input type="text" name="note" value="<%= row.note || '' %>" placeholder="opsional">
        </div>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-body" style="display:flex;gap:10px;flex-wrap:wrap">
      <button class="btn btn-primary" type="submit">Simpan Pengeluaran</button>
      <button class="btn btn-light" type="submit" name="back" value="1">Simpan &amp; Tambah Lagi</button>
      <a class="btn btn-outline" href="<%= url('/transaksi/pengeluaran') %>">Batal</a>
    </div>
  </div>
</form>
<%- include('../partials/foot') %>
